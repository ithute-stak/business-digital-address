BDA_DATABASE_URL=postgresql+psycopg://bda:bda_dev_password@db:5432/bda
BDA_ENVIRONMENT=development
BDA_OFFICIAL_DOMAIN=business.ls
BDA_CORS_ORIGINS=http://localhost:3000

# Ithute Auth token verification for human sessions.
BDA_AUTH_ISSUER=https://auth.ithute.co.ls
BDA_AUTH_JWKS_URL=https://auth.ithute.co.ls/.well-known/jwks.json
BDA_AUTH_AUDIENCE=business-digital-address
BDA_AUTH_REQUIRED=false

# Managed service identity used by this backend when calling Ithute platform APIs.
BDA_ITHUTE_TOKEN_URL=https://auth.ithute.co.ls/v1/service/token
BDA_ITHUTE_SERVICE_CLIENT_ID=business-digital-address
BDA_ITHUTE_SERVICE_CLIENT_SECRET=

# Trusted identity invitation API.
BDA_ITHUTE_INVITE_URL=https://auth.ithute.co.ls/v1/platform/identity/invitations

# Ithute Mail Provisioning API.
BDA_ITHUTE_MAIL_BASE_URL=https://api.ithute.co.ls/platform/mail
BDA_ENABLE_REAL_MAIL_PROVISIONING=false

# External custom-email verification is persisted locally for now.
# Provider delivery is added in a later vertical slice.
BDA_EXTERNAL_EMAIL_VERIFICATION_TTL_MINUTES=30

NEXT_PUBLIC_API_URL=http://localhost:8100
NEXT_PUBLIC_AUTH_URL=https://auth.ithute.co.ls
