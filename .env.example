BDA_DATABASE_URL=postgresql+psycopg://bda:bda_dev_password@db:5432/bda
BDA_ENVIRONMENT=development

# Bootstrap defaults only. Active values live in the database table
# platform_configuration and can later be changed without a code deployment.
BDA_PORTAL_BASE_URL=https://business.ithute.co.ls
BDA_OFFICIAL_DOMAIN=ithute.co.ls
BDA_CORS_ORIGINS=http://localhost:3000

# FastAPI verification of human product access tokens.
BDA_AUTH_ISSUER=https://auth.ithute.co.ls
BDA_AUTH_JWKS_URL=https://auth.ithute.co.ls/.well-known/jwks.json
BDA_AUTH_AUDIENCE=business-digital-address
BDA_AUTH_REQUIRED=false

# Managed machine identity used by the backend for Ithute platform APIs.
BDA_ITHUTE_TOKEN_URL=https://auth.ithute.co.ls/v1/auth/service-token
BDA_ITHUTE_SERVICE_CLIENT_ID=business-digital-address
BDA_ITHUTE_SERVICE_CLIENT_SECRET=
BDA_ITHUTE_INVITE_URL=https://auth.ithute.co.ls/v1/platform/identity-invitations
BDA_ITHUTE_MAIL_BASE_URL=https://api.ithute.co.ls/api/v1/platform/mail
BDA_ENABLE_REAL_MAIL_PROVISIONING=false

# External custom-email verification is local-only until provider delivery is activated.
BDA_EXTERNAL_EMAIL_VERIFICATION_TTL_MINUTES=30

# Next.js browser session/BFF. Local Compose deliberately bypasses central Auth;
# production must set BDA_RUNTIME_ENVIRONMENT=production and bypass=false.
BDA_APP_URL=http://localhost:3000
BDA_API_INTERNAL_URL=http://backend:8100
BDA_ITHUTE_AUTH_URL=https://auth.ithute.co.ls
BDA_OIDC_CLIENT_ID=business-digital-address
BDA_RUNTIME_ENVIRONMENT=development
BDA_DEV_AUTH_BYPASS=true

# Browser calls stay same-origin through the Next.js BFF.
NEXT_PUBLIC_API_URL=/api/bda
