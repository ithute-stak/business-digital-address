# Copy to /opt/business-digital-address/.env.production on the VPS.
# Never commit the real production file.

# Dedicated Business Digital Address PostgreSQL database.
BDA_DB_NAME=bda
BDA_DB_USER=bda
BDA_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
BDA_DATABASE_URL=postgresql+psycopg://bda:REPLACE_WITH_URL_ENCODED_PASSWORD@db:5432/bda

# Bootstrap addressing defaults. The active portal URL and official business
# email domain are stored in PostgreSQL platform_configuration. These values
# exist so a fresh database can bootstrap safely; changing the live values
# later does not require changing application source code.
BDA_PORTAL_BASE_URL=https://business.ithute.co.ls
BDA_OFFICIAL_DOMAIN=ithute.co.ls

# Managed Ithute machine identity. The plaintext secret is created/rotated in
# Ithute Auth and must not be committed to this repository.
BDA_ITHUTE_SERVICE_CLIENT_SECRET=

# Roll out mailbox creation first. Keep external forwarding off until the
# business-digital-address service has mailbox.create + mail.send, an active
# ithute.co.ls grant restricted to bda-, an active mailbox binding, and a
# verified external destination.
BDA_ENABLE_REAL_MAIL_PROVISIONING=false
BDA_ENABLE_REAL_MAIL_FORWARDING=false

BDA_EXTERNAL_EMAIL_VERIFICATION_TTL_MINUTES=30
